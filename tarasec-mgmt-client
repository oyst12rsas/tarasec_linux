#!/bin/bash
# Manage hotspot clients allowed to use the TaraSec management VPN.
set -euo pipefail

[ "$(id -u)" -eq 0 ] || { echo "Run with sudo/root" >&2; exit 1; }
ACTION="${1:-list}"
IP="${2:-}"
FILE="${TARASEC_MGMT_CLIENTS_FILE:-/etc/tarasec/management-clients}"
FIREWALL="/usr/local/sbin/tarasec-management-firewall"

install -d -m 0755 /etc/tarasec
[ -e "$FILE" ] || install -m 0600 /dev/null "$FILE"

valid_ip() {
  [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  local IFS=. a b c d
  read -r a b c d <<<"$1"
  [ "$a" -le 255 ] && [ "$b" -le 255 ] && [ "$c" -le 255 ] && [ "$d" -le 255 ]
}

reload_rules() {
  [ -x "$FIREWALL" ] || { echo "Management firewall is not installed" >&2; exit 1; }
  "$FIREWALL"
}

case "$ACTION" in
  add)
    valid_ip "$IP" || { echo "Usage: tarasec-mgmt-client add <IPv4>" >&2; exit 2; }
    grep -Fxq "$IP" "$FILE" || echo "$IP" >>"$FILE"
    chmod 0600 "$FILE"
    reload_rules
    echo "Granted TaraSec management VPN access to $IP"
    ;;
  remove|del|revoke)
    valid_ip "$IP" || { echo "Usage: tarasec-mgmt-client remove <IPv4>" >&2; exit 2; }
    tmp=$(mktemp)
    grep -Fvx "$IP" "$FILE" >"$tmp" || true
    install -m 0600 "$tmp" "$FILE"
    rm -f "$tmp"
    reload_rules
    echo "Revoked TaraSec management VPN access from $IP"
    ;;
  list)
    echo "Authorized TaraSec management clients:"
    grep -Ev '^\s*(#|$)' "$FILE" || true
    ;;
  reload)
    reload_rules
    ;;
  *)
    echo "Usage: tarasec-mgmt-client {add|remove|list|reload} [IPv4]" >&2
    exit 2
    ;;
esac
