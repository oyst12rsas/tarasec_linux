#!/bin/bash
set -euo pipefail

PORT="${TARASEC_CAPTIVE_LOGIN_PORT:-8080}"
TABLE="ip nds_filter"
CHAIN="ndsRTR"

for _ in $(seq 1 60); do
  if nft list chain $TABLE $CHAIN >/dev/null 2>&1; then
    break
  fi
  sleep 0.5
done

nft list chain $TABLE $CHAIN >/dev/null 2>&1 || {
  echo "openNDS nftables chain not available" >&2
  exit 1
}

if ! nft list chain $TABLE $CHAIN | grep -qE "tcp dport ${PORT} .*accept"; then
  # Insert before openNDS' catch-all reject, but do not bypass its invalid-state
  # protection: only NEW/ESTABLISHED TCP connections to the captive-login port
  # are accepted here.
  nft insert rule $TABLE $CHAIN ct state new,established tcp dport "$PORT" accept
fi
