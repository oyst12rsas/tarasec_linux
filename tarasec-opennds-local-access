#!/bin/bash
set -euo pipefail

PORT="${TARASEC_CAPTIVE_LOGIN_PORT:-8080}"
TABLE="ip nds_filter"
CHAIN="ndsRTR"

for _ in $(seq 1 60); do
  if nft list chain $TABLE $CHAIN >/dev/null 2>&1; then
    break
  fi
  sleep 0.5
done

nft list chain $TABLE $CHAIN >/dev/null 2>&1 || {
  echo "openNDS nftables chain not available" >&2
  exit 1
}

if ! nft list chain $TABLE $CHAIN | grep -qE "tcp dport ${PORT} .*accept"; then
  nft insert rule $TABLE $CHAIN tcp dport "$PORT" accept comment 'TaraSec captive login'
fi
