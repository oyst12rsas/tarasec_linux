#!/bin/bash
# TaraSec hotspot firewall: manage only TaraSec-owned chains.
# Never flush global INPUT/FORWARD/NAT state or change global default policies.
set -euo pipefail

[ -r /etc/tarasec/hotspot.env ] && . /etc/tarasec/hotspot.env

CLIENT_IF="${TARASEC_BRIDGE:-}"
if [ -z "$CLIENT_IF" ] || ! ip link show "$CLIENT_IF" >/dev/null 2>&1; then
  CLIENT_IF=$(awk '$1=="GatewayInterface"{v=$2} END{print v}' /etc/opennds/opennds.conf 2>/dev/null || true)
fi
if [ -z "$CLIENT_IF" ] || ! ip link show "$CLIENT_IF" >/dev/null 2>&1; then
  CLIENT_IF=$(ndsctl status 2>/dev/null | sed -n 's/^Managed interface: //p' | head -1)
fi
[ -n "$CLIENT_IF" ] && ip link show "$CLIENT_IF" >/dev/null 2>&1 || { echo "Unable to detect TaraSec client interface" >&2; exit 1; }

HOTSPOT_ADDR="${TARASEC_HOTSPOT_ADDR:-}"
if [ -z "$HOTSPOT_ADDR" ] || ! ip -4 addr show dev "$CLIENT_IF" | grep -q " $HOTSPOT_ADDR/"; then
  HOTSPOT_ADDR=$(ip -4 -o addr show dev "$CLIENT_IF" scope global | awk '{split($4,a,"/"); print a[1]; exit}')
fi
[ -n "$HOTSPOT_ADDR" ] || { echo "Unable to detect TaraSec hotspot IPv4 address" >&2; exit 1; }
SUBNET="${HOTSPOT_ADDR%.*}.0/24"

UPSTREAMS="${TARASEC_UPSTREAM_IFACES:-}"
if [ -z "$UPSTREAMS" ]; then
  UPSTREAMS=$(ip -o route show default | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' | sort -u | tr '\n' ' ')
fi
[ -n "$UPSTREAMS" ] || { echo "Unable to detect Internet/upstream interface" >&2; exit 1; }

sysctl -w net.ipv4.ip_forward=1 >/dev/null

ensure_chain() {
  local table="$1" chain="$2"
  if [ "$table" = filter ]; then
    iptables -N "$chain" 2>/dev/null || true
    iptables -F "$chain"
  else
    iptables -t "$table" -N "$chain" 2>/dev/null || true
    iptables -t "$table" -F "$chain"
  fi
}

ensure_jump() {
  local table="$1" parent="$2" chain="$3"
  if [ "$table" = filter ]; then
    iptables -C "$parent" -j "$chain" 2>/dev/null || iptables -I "$parent" 1 -j "$chain"
  else
    iptables -t "$table" -C "$parent" -j "$chain" 2>/dev/null || iptables -t "$table" -I "$parent" 1 -j "$chain"
  fi
}

ensure_chain filter TARASEC-HOTSPOT-IN
ensure_chain filter TARASEC-HOTSPOT-FWD
# Dynamic per-client counter rules are populated by tarasec-usage-sync.
# Recreating the firewall resets these counters intentionally; the usage sync
# detects counter resets and continues from the new value without going negative.
ensure_chain filter TARASEC-HOTSPOT-COUNT
ensure_chain nat TARASEC-HOTSPOT-PRE
ensure_chain nat TARASEC-HOTSPOT-NAT

ensure_jump filter INPUT TARASEC-HOTSPOT-IN
ensure_jump filter FORWARD TARASEC-HOTSPOT-FWD
ensure_jump nat PREROUTING TARASEC-HOTSPOT-PRE
ensure_jump nat POSTROUTING TARASEC-HOTSPOT-NAT

# Local hotspot services. Port 80 remains the normal web/back-office listener,
# while 8080 is dedicated to subscriber login before openNDS authentication.
iptables -A TARASEC-HOTSPOT-IN -i "$CLIENT_IF" -s "$SUBNET" -p udp --dport 67 -j ACCEPT
iptables -A TARASEC-HOTSPOT-IN -i "$CLIENT_IF" -s "$SUBNET" -p udp --dport 53 -j ACCEPT
iptables -A TARASEC-HOTSPOT-IN -i "$CLIENT_IF" -s "$SUBNET" -p tcp --dport 53 -j ACCEPT
iptables -A TARASEC-HOTSPOT-IN -i "$CLIENT_IF" -s "$SUBNET" -p tcp --dport 80 -j ACCEPT
iptables -A TARASEC-HOTSPOT-IN -i "$CLIENT_IF" -s "$SUBNET" -p tcp --dport 8080 -j ACCEPT
iptables -A TARASEC-HOTSPOT-IN -i "$CLIENT_IF" -s "$SUBNET" -p tcp --dport 2050 -j ACCEPT
iptables -A TARASEC-HOTSPOT-IN -j RETURN

# Force ordinary DNS from hotspot clients through the local TaraSec resolver.
iptables -t nat -A TARASEC-HOTSPOT-PRE -i "$CLIENT_IF" -s "$SUBNET" -p udp --dport 53 -j DNAT --to-destination "$HOTSPOT_ADDR:53"
iptables -t nat -A TARASEC-HOTSPOT-PRE -i "$CLIENT_IF" -s "$SUBNET" -p tcp --dport 53 -j DNAT --to-destination "$HOTSPOT_ADDR:53"
iptables -t nat -A TARASEC-HOTSPOT-PRE -j RETURN

# Count authenticated clients before generic forwarding accepts them. The
# count chain never authorizes traffic; every rule returns to this chain and
# openNDS remains the actual per-client authorization layer.
iptables -A TARASEC-HOTSPOT-FWD -j TARASEC-HOTSPOT-COUNT
iptables -A TARASEC-HOTSPOT-COUNT -j RETURN

# Generic client forwarding/NAT. openNDS remains the per-client authorization layer.
for upstream in $UPSTREAMS; do
  [ "$upstream" = "$CLIENT_IF" ] && continue
  iptables -A TARASEC-HOTSPOT-FWD -i "$CLIENT_IF" -o "$upstream" -s "$SUBNET" -j ACCEPT
  iptables -A TARASEC-HOTSPOT-FWD -i "$upstream" -o "$CLIENT_IF" -d "$SUBNET" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
  iptables -t nat -A TARASEC-HOTSPOT-NAT -s "$SUBNET" -o "$upstream" -j MASQUERADE
done
iptables -A TARASEC-HOTSPOT-FWD -j RETURN
iptables -t nat -A TARASEC-HOTSPOT-NAT -j RETURN
