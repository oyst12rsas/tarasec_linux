#!/bin/bash
# TaraSec selective hotspot -> management VPN forwarding.
# Only explicitly authorized hotspot client IPs are allowed into the management
# overlay (normally NetBird wt0). Ordinary subscribers remain Internet-only.
set -euo pipefail

[ -r /etc/tarasec/hotspot.env ] && . /etc/tarasec/hotspot.env

CLIENT_IF="${TARASEC_BRIDGE:-}"
if [ -z "$CLIENT_IF" ] || ! ip link show "$CLIENT_IF" >/dev/null 2>&1; then
  CLIENT_IF=$(awk '$1=="GatewayInterface"{v=$2} END{print v}' /etc/opennds/opennds.conf 2>/dev/null || true)
fi
if [ -z "$CLIENT_IF" ] || ! ip link show "$CLIENT_IF" >/dev/null 2>&1; then
  CLIENT_IF=$(ndsctl status 2>/dev/null | sed -n 's/^Managed interface: //p' | head -1)
fi
[ -n "$CLIENT_IF" ] && ip link show "$CLIENT_IF" >/dev/null 2>&1 || { echo "Unable to detect TaraSec client interface" >&2; exit 1; }

HOTSPOT_ADDR="${TARASEC_HOTSPOT_ADDR:-}"
if [ -z "$HOTSPOT_ADDR" ]; then
  HOTSPOT_ADDR=$(ip -4 -o addr show dev "$CLIENT_IF" scope global | awk '{split($4,a,"/"); print a[1]; exit}')
fi
[ -n "$HOTSPOT_ADDR" ] || { echo "Unable to detect hotspot address" >&2; exit 1; }
SUBNET="${HOTSPOT_ADDR%.*}.0/24"

MGMT_IF="${TARASEC_MGMT_IFACE:-}"
if [ -z "$MGMT_IF" ]; then
  for candidate in wt0 netbird0; do
    if ip link show "$candidate" >/dev/null 2>&1; then MGMT_IF="$candidate"; break; fi
  done
fi
[ -n "$MGMT_IF" ] && ip link show "$MGMT_IF" >/dev/null 2>&1 || {
  echo "No TaraSec management VPN interface detected; selective management forwarding disabled." >&2
  exit 0
}

ALLOW_FILE="${TARASEC_MGMT_CLIENTS_FILE:-/etc/tarasec/management-clients}"
install -d -m 0755 /etc/tarasec
[ -e "$ALLOW_FILE" ] || install -m 0600 /dev/null "$ALLOW_FILE"

sysctl -w net.ipv4.ip_forward=1 >/dev/null

iptables -N TARASEC-MGMT-FWD 2>/dev/null || true
iptables -F TARASEC-MGMT-FWD
iptables -C FORWARD -j TARASEC-MGMT-FWD 2>/dev/null || iptables -I FORWARD 1 -j TARASEC-MGMT-FWD

iptables -t nat -N TARASEC-MGMT-NAT 2>/dev/null || true
iptables -t nat -F TARASEC-MGMT-NAT
iptables -t nat -C POSTROUTING -j TARASEC-MGMT-NAT 2>/dev/null || iptables -t nat -I POSTROUTING 1 -j TARASEC-MGMT-NAT

while IFS= read -r ip; do
  ip="${ip%%#*}"
  ip="$(printf '%s' "$ip" | xargs)"
  [ -n "$ip" ] || continue
  case "$ip" in
    ${HOTSPOT_ADDR%.*}.*) ;;
    *) echo "Ignoring management client outside hotspot subnet: $ip" >&2; continue ;;
  esac

  # Authorized owners/admins may initiate management-overlay sessions.
  iptables -A TARASEC-MGMT-FWD -i "$CLIENT_IF" -o "$MGMT_IF" -s "$ip" -m conntrack --ctstate NEW,ESTABLISHED,RELATED -j ACCEPT
  iptables -A TARASEC-MGMT-FWD -i "$MGMT_IF" -o "$CLIENT_IF" -d "$ip" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  iptables -t nat -A TARASEC-MGMT-NAT -s "$ip" -o "$MGMT_IF" -j MASQUERADE

done < "$ALLOW_FILE"

iptables -A TARASEC-MGMT-FWD -j RETURN
iptables -t nat -A TARASEC-MGMT-NAT -j RETURN

echo "Management interface: $MGMT_IF"
echo "Client interface:     $CLIENT_IF"
echo "Authorized clients:"
grep -Ev '^\s*(#|$)' "$ALLOW_FILE" || true
