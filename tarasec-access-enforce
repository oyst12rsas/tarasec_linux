#!/bin/bash
# Keep openNDS authenticated clients synchronized with TaraSec's existing access table.
# First account current openNDS usage, then refresh access from active
# sessions/subscriptions, then enforce it in openNDS.
# Missing row, hasaccess != 1, or DB/checker failure => fail closed and deauthenticate.
set -u

CHECKER="${TARASEC_ACCESS_CHECKER:-/usr/local/sbin/tarasec-access-check}"
USAGE="${TARASEC_USAGE_SYNC:-/usr/local/sbin/tarasec-usage-sync}"
REFRESHER="${TARASEC_ACCESS_REFRESHER:-/usr/local/sbin/tarasec-access-refresh}"
OUT="${TARASEC_ACCESS_STATE:-/run/tarasec-access-enforcement.json}"
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

checked=0
revoked=0
errors=0
usage_ok=true
refresh_ok=true

# Usage must be synchronized before refreshing access so quota exhaustion in
# this poll can remove access immediately.
if [ -x "$USAGE" ]; then
  if ! "$USAGE"; then
    usage_ok=false
    errors=$((errors+1))
  fi
fi

if [ -x "$REFRESHER" ]; then
  if ! "$REFRESHER"; then
    refresh_ok=false
    errors=$((errors+1))
  fi
fi

if ! command -v ndsctl >/dev/null 2>&1 || [ ! -x "$CHECKER" ]; then
  printf '{"ok":false,"usage_ok":%s,"refresh_ok":%s,"checked":0,"revoked":0,"errors":%d,"reason":"missing_ndsctl_or_checker"}\n' "$usage_ok" "$refresh_ok" "$((errors+1))" >"$OUT"
  exit 1
fi

if ! ndsctl json >"$TMP" 2>/dev/null; then
  printf '{"ok":false,"usage_ok":%s,"refresh_ok":%s,"checked":0,"revoked":0,"errors":%d,"reason":"ndsctl_failed"}\n' "$usage_ok" "$refresh_ok" "$((errors+1))" >"$OUT"
  exit 1
fi

while IFS=$'\t' read -r mac ip state; do
  [ -n "$mac" ] || continue
  [ "$state" = "Authenticated" ] || continue
  checked=$((checked+1))

  if "$CHECKER" "$ip"; then
    continue
  fi

  if ndsctl deauth "$mac" >/dev/null 2>&1; then
    revoked=$((revoked+1))
    logger -t tarasec-access "revoked $mac/$ip: access table no longer allows client"
  else
    errors=$((errors+1))
    logger -t tarasec-access "FAILED to revoke $mac/$ip"
  fi
done < <(python3 - "$TMP" <<'PY'
import json, sys
with open(sys.argv[1], encoding='utf-8') as f:
    data=json.load(f)
for mac, c in data.get('clients', {}).items():
    print(f"{mac}\t{c.get('ip','')}\t{c.get('state','')}")
PY
)

ok=true
[ "$errors" -eq 0 ] || ok=false
printf '{"ok":%s,"usage_ok":%s,"refresh_ok":%s,"checked":%d,"revoked":%d,"errors":%d}\n' "$ok" "$usage_ok" "$refresh_ok" "$checked" "$revoked" "$errors" >"$OUT"
[ "$errors" -eq 0 ]
